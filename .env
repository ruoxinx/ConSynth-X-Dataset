# Copy to .env and fill in.  Source with:  set -a; source .env; set +a

# Path to the ConSynth-X checkout. Auto-detected if unset.
# CONSYNTH_REPO_ROOT=/abs/path/to/ConSynth-X

# Directory holding base datasets + augmented outputs. See generation/_paths.py.
# Expected layout:
#   $CONSYNTH_DATA_ROOT/LouisChen15___construction_site/   (HF arrow shards)
#   $CONSYNTH_DATA_ROOT/SODA/data/SODA VOCdevkit/VOCdevkit/VOC2007/
#   $CONSYNTH_DATA_ROOT/augmentation_data/
#   $CONSYNTH_DATA_ROOT/validation_data/
CONSYNTH_DATA_ROOT=/abs/path/to/data

# Conda env used in SLURM submit scripts
CONSYNTH_CONDA_ENV=VLM

# Weight bundle (see weights/README.md). One of:
# CONSYNTH_WEIGHTS_URL=https://zenodo.org/records/<id>/files
# CONSYNTH_WEIGHTS_SRC=/path/to/local/mirror



